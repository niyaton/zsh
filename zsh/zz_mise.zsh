# Apply the activation generated by 01_mise.zsh before the first prompt.
if [[ -n ${_mise_activation_fd:-} ]]; then
  _mise_activation=$(<&$_mise_activation_fd)
  exec {_mise_activation_fd}<&-

  # mise embeds PATH in its output, so regenerate if a later file changed it.
  if [[ $PATH != "$_mise_activation_path" ]]; then
    _mise_activation=$(command mise activate zsh) || _mise_activation=
  fi
  unset _mise_activation_fd _mise_activation_path
  [[ -z $_mise_activation ]] || eval "$_mise_activation"
  unset _mise_activation
fi
